{
  "name": "nda_test",
  "version": "0.0.1",
  "description": "gRPC testing",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build producer && nest build consumer",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "oxlint apps/ libs/",
    "proto:gen": "grpc_tools_node_protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./libs/users-proto/src/generated --ts_proto_opt=nestJs=true,fileSuffix=.pb -I ./proto ./proto/users.proto",
    "start:producer": "nest start producer",
    "start:consumer": "nest start consumer",
    "start:dev:producer": "nest start producer --watch",
    "start:prod:producer": "node dist/apps/producer/main",
    "start:prod:consumer": "node dist/apps/consumer/main"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/microservices": "^12.1.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@rspack/core": "^2.2.8",
    "@types/node": "^24.0.0",
    "grpc-tools": "^1.13.1",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "ts-proto": "^2.12.4",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "webpack-node-externals": "^3.0.0"
  }
}
